// 画面（Next.js の静的書き出し）を配信する Worker。out/ を静的アセットとして配信し、
// /api/* だけ workers/site/src/index.ts が受ける（035 お問い合わせ）。
// 定期取得の Worker は workers/ingest/wrangler.jsonc で別に管理する。
// 秘密情報は `wrangler secret put` で登録し、このファイルには書かない（`!` ではなく別のターミナルで）。
//   npx wrangler secret put DISCORD_WEBHOOK_URL（お問い合わせの送り先。定期取得の Worker と同じ値）
// ローカル実行（npm run preview）では、ルートの .dev.vars に書く（雛形は .dev.vars.example）
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dear-life",
  "main": "workers/site/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // お問い合わせの連続送信を、同じ接続元から1分に3回までにする。namespace_id はこのアカウントの中で重ならない数字
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1035",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
