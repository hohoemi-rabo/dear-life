{
  "name": "dear-life",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "ingest:dev": "wrangler dev --config workers/ingest/wrangler.jsonc --test-scheduled",
    "ingest:deploy": "wrangler deploy --config workers/ingest/wrangler.jsonc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p workers/ingest"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "wrangler": "^4.151.3"
  }
}
