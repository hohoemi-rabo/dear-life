{
  "name": "dear-life",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build --turbopack",
    "postbuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-sw.mjs",
    "start": "next start",
    "lint": "eslint",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "ingest:dev": "wrangler dev --config workers/ingest/wrangler.jsonc --test-scheduled",
    "ingest:deploy": "wrangler deploy --config workers/ingest/wrangler.jsonc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p workers/ingest",
    "test": "vitest run",
    "test:watch": "vitest",
    "town-map:sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-town-district-map-sql.mjs",
    "bus:sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-bus-sql.mjs",
    "train:sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-train-sql.mjs",
    "childcare:sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-childcare-sql.mjs",
    "education:sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-education-sql.mjs",
    "evacuation:sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-evacuation-sql.mjs",
    "public-facilities:sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-public-facilities-sql.mjs",
    "population:sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-population-sql.mjs",
    "scenes:sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-scenes-sql.mjs",
    "pixel": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-pixel.mjs",
    "illust": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-illust.mjs"
  },
  "dependencies": {
    "maplibre-gl": "6.14.0",
    "next": "15.5.28",
    "polygon-clipping": "0.15.7",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/eslintrc": "^3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
