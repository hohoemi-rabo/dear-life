# 画面から読む Supabase の公開情報（ビルド時に埋め込まれる。秘密ではない）
# 値は Supabase の Project Settings → API Keys で確認する
NEXT_PUBLIC_SUPABASE_URL=https://ywugkkofnqkpnzkmucyv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# service_role key・REINFOLIB_API_KEY はここに書かない。Cloudflare の Secret にだけ置く（workers/ingest/wrangler.jsonc 参照）

# 地図（/chizu、032）の Google Maps Platform。キーは画面に出る値なので、Google Cloud で
# 使えるサイト（本番の URL と localhost:3000）と API（Maps JavaScript API だけ）を必ず制限する
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza_xxx
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=xxx

# e-Stat API のアプリケーションID（034）。手元の npm run rent:sql だけが使う。画面にも Worker にも入れない（NEXT_PUBLIC_ を付けない）
ESTAT_APP_ID=xxx
